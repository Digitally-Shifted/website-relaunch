---
/*
 * Card (DESIGN-SPEC 4.5): sharp corners, hairline border, no shadow at
 * rest. Interactive cards lift on hover with the fast duration.
 */
interface Props {
  title: string;
  dark?: boolean;
  interactive?: boolean;
}

const { title, dark = true, interactive = false } = Astro.props;
---

<div
  class:list={[
    'card h-full',
    dark ? 'border-grey-800 text-text-on-dark' : 'card--light text-text-on-light',
    interactive && 'card--interactive',
  ]}
>
  <h3 class:list={['text-h3', dark ? 'text-paper' : 'text-text-on-light']}>{title}</h3>
  <div class="mt-3 text-body-sm">
    <slot />
  </div>
  <slot name="action" />
</div>
