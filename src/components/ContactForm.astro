---
/*
 * Contact form (conversion spec 4). The one form on the site at launch.
 *
 * Submission path: a normal browser POST to /api/contact on the same
 * origin (spec 4.3). The backend (form-backend/) re-validates, stores the
 * lead, applies the spam rules and rate limit, and answers 303 to the
 * thank-you page with the lead_ok cookie on genuine success. The
 * thank-you page fires the one conversion event from two signals
 * (spec 7.2): the sessionStorage.lead_pending written by the behaviour
 * module and that cookie. Behaviour lives in src/scripts/contact-form.js;
 * styles follow DESIGN-SPEC 4.6 (dark ground).
 */
import { withBase } from '../lib/urls';
import { needOptions } from '../lib/site.config';

interface Props {
  /**
   * Landing-page mode (conversion spec 3.8, DIG-133): when set, the form
   * drops the business field and the need select and fills `need` through
   * a hidden field instead. The submit label stays `Send enquiry` with no
   * live switching, and the message becomes optional.
   */
  fixedNeed?: (typeof needOptions)[number]['value'] | 'checklist';
  /** Page path recorded as `form_location` (spec 4.4). */
  formLocation?: string;
  /**
   * Shiny Text sending state (DIG-1009 spec 4.4): the submit button's
   * disabled state gains the shine sweep. Opt-in so the /checklist/
   * funnel keeps its current behavior.
   */
  shiny?: boolean;
}

const { fixedNeed, formLocation = '/contact', shiny = false } = Astro.props;

const quoteNeeds = needOptions
  .filter((option) => option.quoteIntent)
  .map((option) => option.value)
  .join(',');
---

<form
  class:list={['ds-form', shiny && 'ds-form--shiny']}
  method="POST"
  action="/api/contact"
  novalidate
  data-ds-contact-form
  data-ds-location="content"
  data-quote-needs={quoteNeeds}
  data-quote-label="Request quote"
  data-form-location={formLocation}
  aria-describedby="contact-consent"
  {...(fixedNeed ? { 'data-need': fixedNeed, 'data-message-optional': 'true' } : {})}
>
  <div class="ds-summary" data-ds-summary tabindex="-1" hidden></div>

  <div class="ds-form-grid">
    <div class="ds-field">
      <label class="ds-label" for="field-name">Your name (required)</label>
      <input
        class="ds-control"
        id="field-name"
        name="name"
        type="text"
        maxlength="100"
        autocomplete="name"
        required
        data-ds-field="name"
      />
      <p class="ds-error" data-ds-error-for="name"></p>
    </div>

    <div class="ds-field">
      <label class="ds-label" for="field-email">Email</label>
      <input
        class="ds-control"
        id="field-email"
        name="email"
        type="email"
        autocomplete="email"
        data-ds-field="email"
      />
      <p class="ds-error" data-ds-error-for="email"></p>
    </div>

    <div class="ds-field">
      <label class="ds-label" for="field-phone">Phone (optional)</label>
      <input
        class="ds-control"
        id="field-phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        data-ds-field="phone"
      />
      <p class="ds-error" data-ds-error-for="phone"></p>
    </div>

    {!fixedNeed && (
      <div class="ds-field">
        <label class="ds-label" for="field-business">Business name (optional)</label>
        <input
          class="ds-control"
          id="field-business"
          name="business"
          type="text"
          maxlength="120"
          autocomplete="organization"
          data-ds-field="business"
        />
        <p class="ds-error" data-ds-error-for="business"></p>
      </div>
    )}

    {!fixedNeed && (
      <div class="ds-field">
        <label class="ds-label" for="field-need">What do you need? (required)</label>
        <select class="ds-control" id="field-need" name="need" required data-ds-field="need">
          {needOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
        <p class="ds-error" data-ds-error-for="need"></p>
      </div>
    )}
    {fixedNeed && <input type="hidden" name="need" value={fixedNeed} />}

    <div class="ds-field ds-field--full">
      <label class="ds-label" for="field-message">
        Tell us about your project{fixedNeed ? ' (optional)' : ' (required)'}
      </label>
      <textarea
        class="ds-control"
        id="field-message"
        name="message"
        rows="5"
        maxlength="5000"
        required={!fixedNeed}
        data-ds-field="message"></textarea>
      <p class="ds-error" data-ds-error-for="message"></p>
    </div>
  </div>

  <!-- Honeypot (conversion spec 6.2): hidden from people, filled by bots. -->
  <input
    class="ds-honeypot"
    type="text"
    name="company_website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    data-ds-field="company_website"
  />

  <!-- Server contract fields (spec 4.4): set at render by the behaviour
       module; UTM values are filled from the page URL. Without JavaScript
       they stay empty and the server skips the time check, so the form
       still works (honeypot and rate limit stay active). -->
  <input type="hidden" name="form_location" value={formLocation} />
  <input type="hidden" name="form_started_at" value="" />
  <input type="hidden" name="submission_id" value="" />
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />

  <p class="ds-consent" id="contact-consent">
    We use your details to reply to this enquiry. We do not sell them. See our
    <a href={withBase('/privacy')} class="link-dark">privacy notice</a>.
  </p>

  <button class="btn btn--primary" type="submit" data-ds-submit>Send enquiry</button>

  <noscript>
    <div class="ds-fallback">
      <p class="text-body text-text-on-dark-muted">
        The form works without JavaScript too. Or reach us directly: call
        <a href="tel:+27631718750" class="link-dark">+27 63 171 8750</a>, WhatsApp
        <a href="https://wa.me/27631718750" class="link-dark">+27 63 171 8750</a>, or email
        <a href="mailto:baruch@digitallyshifted.com" class="link-dark">baruch@digitallyshifted.com</a>.
      </p>
    </div>
  </noscript>
</form>

<script>
  import { setupContactForm } from '../scripts/contact-form.js';

  const form = document.querySelector('form[data-ds-contact-form]');
  if (form) {
    setupContactForm(form);
  }
</script>
