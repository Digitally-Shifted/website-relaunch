---
/*
 * Grain layer (DIG-993 spec 7.3, D7). Server-rendered inline SVG: one
 * fractal-noise-filtered rect per surface at 4 percent opacity. A filtered
 * SVG rect is not an LCP candidate type, so the hero H1 text stays the
 * LCP element (Creative Director ruling, 2026-10-22; supersedes the
 * `.grain::after` CSS tile, which painted the full band as one image).
 * Decorative only: aria-hidden, no pointer events, no animation.
 */
interface Props {
  /** Unique filter id per surface (hero band, CTA band). */
  filterId: string;
}

const { filterId } = Astro.props;
---

<svg
  aria-hidden="true"
  focusable="false"
  style="position:absolute;inset:0;width:100%;height:100%;opacity:.04;pointer-events:none"
>
  <filter id={filterId}>
    <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter={`url(#${filterId})`} />
</svg>
