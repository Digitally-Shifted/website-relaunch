---
/*
 * 404 (conversion spec 3.7): recover the visit. A headline, one line, one
 * "Get a quote" button and one link home. No other content.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Start again from the Digitally Shifted home page."
  path="/404"
>
  <div class="bg-carbon">
    <div class="container-ds pt-32 pb-40 text-center">
      <p class="text-eyebrow uppercase text-text-on-dark-muted">404</p>
      <h1 class="mt-4 text-display text-paper">That page <em>does not exist</em>.</h1>
      <p class="mx-auto mt-4 max-w-md text-body-lg text-text-on-dark-muted">
        The address may be old or mistyped.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
        <a href={withBase('/contact?need=quote')} class="btn btn--primary" data-ds-location="content">
          Get a quote
        </a>
        <a href={withBase('/')} class="link-dark text-body">Back to the home page</a>
      </div>
    </div>
  </div>
</BaseLayout>
