---
/*
 * Thank-you page (conversion spec 3.5): confirms the submission and gives
 * direct routes for speed. Reached only through the form's 303 redirect;
 * never linked from navigation. Headline takes focus on load.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../lib/site.config';
import { withBase } from '../../lib/urls';
---

<BaseLayout
  title="Thank you"
  description="We have your message. We aim to reply within one business day."
  path="/contact/thank-you"
  noindex={true}
  hideHeaderCta={true}
  hideMobileBar={true}
>
  <div class="bg-carbon">
    <div class="container-ds pt-24 pb-32 md:pt-32 md:pb-40">
      <div class="max-w-2xl">
        <h1 id="thankyou-title" tabindex="-1" class="text-display text-paper">
          Thank you. <em>We have your message.</em>
        </h1>
        <p class="mt-4 text-body-lg text-text-on-dark-muted">
          We aim to reply within one business day.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={site.phoneHref}
            class="btn btn--primary"
            data-ds-location="thankyou">Call</a
          >
          <a
            href={site.whatsappHref}
            class="btn btn--secondary-dark"
            data-ds-location="thankyou"
            rel="noopener">WhatsApp us</a
          >
        </div>
        <p class="mt-8" id="checklist-offer" hidden>
          <a href={withBase('/checklist/print/')} class="btn btn--secondary-dark"
            >Get the checklist</a
          >
        </p>
        <script is:inline>
          /*
           * Checklist link (DIG-133): the form backend appends
           * ?offer=checklist to the 303 redirect for need=checklist
           * successes. Ordinary enquiries never carry the marker, so the
           * link stays hidden for them. Inline so the link is present
           * before first paint. No event fires here (spec 3.5).
           */
          if (new URLSearchParams(location.search).get('offer') === 'checklist') {
            document.getElementById('checklist-offer')?.removeAttribute('hidden');
          }
        </script>
        <p class="mt-8">
          <a href={withBase('/services')} class="link-dark text-body">See what we do</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  document.getElementById('thankyou-title')?.focus();
</script>

<script>
  /*
   * Lead conversion firing (conversion spec §7.2, two-signal rule).
   * The form (DIG-69) writes sessionStorage.lead_pending = {need,
   * form_location} before its POST; the server sets the lead_ok cookie on a
   * genuine success only. Both signals together mean one real lead: fire
   * exactly one conversion event, then clear both signals so a refresh
   * never double counts and a spam redirect never counts at all. Events
   * only send when analytics started (a GA4 measurement ID was set at
   * build time); the signals still clear, so the count cannot back up.
   */
  import { needOptions } from '../../lib/site.config';

  interface LeadPending {
    need: string;
    form_location?: string;
  }
  const analytics = (
    window as unknown as {
      DSAnalytics?: {
        ready: boolean;
        contactSubmit(params: object): void;
        quoteRequest(params: object): void;
      };
    }
  ).DSAnalytics;

  const pendingRaw = sessionStorage.getItem('lead_pending');
  const hasLeadOk = /(?:^|;\s*)lead_ok=/.test(document.cookie);
  if (pendingRaw && hasLeadOk) {
    try {
      const lead = JSON.parse(pendingRaw) as LeadPending;
      const option = needOptions.find((o) => o.value === lead.need);
      if (analytics && analytics.ready) {
        const params = { formLocation: lead.form_location };
        if (option?.quoteIntent) {
          analytics.quoteRequest(params);
        } else {
          analytics.contactSubmit(params);
        }
      }
    } catch {
      /* malformed signal: clear it below, never block the page */
    }
    sessionStorage.removeItem('lead_pending');
    document.cookie = 'lead_ok=; Max-Age=0; path=/';
  }
</script>
