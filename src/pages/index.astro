---
/*
 * Home (conversion spec 3.1): hero, services summary with four cards and
 * the Care plan panel, proof (Variant B "How we work"), closing band.
 *
 * FINAL COPY: docs/copy/home-page-copy.md v1.1 (DIG-79/DIG-121/DIG-124).
 * Owner decisions of 2026-10-20 applied: prices removed (HC1), Launch
 * promise at 20 working days with the late-content line (HC2), softened
 * who-it-is-for (HC6), reply-time line under the closing button (HC7).
 * Logo strip stays parked (HC3/B1/B2). Production deploy waits for the
 * go-live decision on DIG-79.
 *
 * SEO: preserved values verbatim (DIG-101). No title suffix, full robots
 * directives, og image served from this host at the original 1904x901.
 * Exactly one H1: the old DOM repeated the phrase twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Card from '../components/Card.astro';
import CtaBand from '../components/CtaBand.astro';
import { withBase } from '../lib/urls';

const services = [
  {
    title: 'Website design and development',
    body: 'We design and build your website around your customers and your goals. Fast pages, clear structure, and a site you can grow. You own the result, and we stay available to look after it. Right for your first website, or a rebuild of an old one. The once-off build is Launch: live in 20 working days from complete content. Late content moves the launch date by the same number of days. You approve the quote before any work starts.',
    href: '/services#web-design',
  },
  {
    title: 'Hosting and management',
    body: 'We host your site, keep its software current, and fix problems before visitors see them. Backups, updates, and security are our job, not your weekend. Your site stays fast and safe while you run your business. Take hosting and management on its own, or as part of the Care plan. Right if your site is live but nobody looks after it.',
    href: '/services#hosting',
  },
  {
    title: 'Care plan',
    body: 'The monthly bundle. One price covers design, hosting, management, SEO basics, and small changes: the everyday edits your site needs. Your website stays current without a large upfront cost, and we keep improving it. No new quote every time something changes. Take it with a new build, or on its own.',
    href: '/services#waas',
  },
  {
    title: 'SEO and AIO',
    body: 'Technical foundations, clear content, and steady improvement help the right people find you on Google. AIO extends that work to visibility in AI-generated answers. No tricks that put your domain at risk. Right if customers search for what you do, and they cannot find you.',
    href: '/services#seo',
  },
];

const covers = ['Design', 'Hosting', 'Management', 'SEO basics', 'Small changes'];

const steps = [
  {
    lead: 'You send the short form.',
    body: 'We talk about your business, and then you get a clear quote. You decide with the price in front of you.',
  },
  {
    lead: 'We design and build.',
    body: 'Your website takes shape around your customers. You see it and approve it before it goes live.',
  },
  {
    lead: 'We look after it.',
    body: 'After launch, we host it, manage it, and improve it. Every month.',
  },
];
---

<BaseLayout
  title="Digital Marketing Agency South Africa | Digitally Shifted"
  titleSuffix={false}
  description="Digitally Shifted builds, hosts and manages websites for South African businesses. Web design, the Care plan and SEO to bring in leads."
  path="/"
  robots="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
  ogImage="/og/home-page-banner.jpg"
  ogImageWidth="1904"
  ogImageHeight="901"
  ogImageAlt="Digitally Shifted digital marketing agency hero banner"
>
  <PageHero
    eyebrow="Websites, hosting and SEO"
    statement="Digital Marketing Agency South Africa"
    opener="Digitally Shifted designs, builds, hosts, and manages websites for South African businesses, so new customers find you and contact you."
    ctaHref="/contact?need=quote"
    ctaLabel="Get a quote"
    secondaryHref="/services"
    secondaryLabel="See what is included"
  />

  <section class="bg-carbon" aria-labelledby="what-we-do">
    <div class="container-ds section">
      <SectionHeader
        id="what-we-do"
        heading="What we do"
        opener="Four services cover the whole life of your website. Buy a website once with Launch, and own it outright. Or put your website on the Care plan and let us run it for a monthly fee. Choose what you need today and add more later."
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          services.map((service) => (
            <Card title={service.title} interactive>
              <p class="text-text-on-dark-muted">{service.body}</p>
              <a
                slot="action"
                href={withBase(service.href)}
                class="link-dark mt-4 inline-block text-body-sm"
              >
                {service.title}
              </a>
            </Card>
          ))
        }
      </div>
      <div class="feature-panel corner-cut-md mt-16">
        <h3 id="care-plan" class="text-display text-paper">
          One monthly plan. <em>Everything included.</em>
        </h3>
        <p class="mt-4 max-w-xl text-body-lg text-text-on-dark-muted">
          The Care plan turns your website into a service we run for you. You never
          touch the technical work. Your site stays current, and the cost stays
          predictable.
        </p>
        <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-body text-paper">
          {
            covers.map((item) => (
              <li class="flex items-center gap-2">
                <span aria-hidden="true" class="text-accent">
                  +
                </span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mt-4 max-w-xl text-body-sm text-text-on-dark-muted">
        Need an online shop, a booking system, or a member area? Those are custom
        builds, quoted per project. They sit outside the fixed Launch scope.
      </p>
      <div class="mt-10">
        <a href={withBase('/contact?need=quote')} class="btn btn--primary" data-ds-location="content">
          Get a quote
        </a>
      </div>
    </div>
  </section>

  <section class="bg-grey-100" aria-labelledby="how-we-work">
    <div class="container-ds section">
      <SectionHeader
        id="how-we-work"
        dark={false}
        heading="How we work"
        opener="Your customers are already online. You do not have the time or the skill to run a website, and you should not have to. That is our job."
      />
      <ol class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li>
              <p class="text-h4 text-text-on-light">
                <span aria-hidden="true" class="mr-2 text-text-on-light-muted">
                  {index + 1}.
                </span>
                <strong>{step.lead}</strong>
              </p>
              <p class="mt-2 text-body-sm text-text-on-light-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-16 grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="text-h3 text-text-on-light">Who it is for</h3>
          <p class="mt-3 text-body text-text-on-light-muted">
            Owner-run South African businesses. If your customers find you
            through Google and word of mouth, this is for you.
          </p>
        </div>
        <div>
          <h3 class="text-h3 text-text-on-light">One supplier</h3>
          <p class="mt-3 text-body text-text-on-light-muted">
            One supplier stays accountable for your whole website. When something
            needs fixing, you do not chase three suppliers. You pay a predictable
            monthly cost, not a large upfront sum. The technical work stays with
            us.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading={'Ready <em>when you are</em>'}
    line="Tell us what your business needs. We reply with a clear quote, and work starts only when you approve it."
    ctaHref="/contact?need=quote"
    ctaLabel="Get a quote"
    note="We aim to reply within one business day."
  />
</BaseLayout>
