---
/*
 * Home — Phase 1 rebuild ("precision in motion", DIG-993 build spec).
 *
 * Eleven regions in DOM order (spec section 3): sticky header, hero,
 * facts row, why us, services index, process, promise band, care plan,
 * checklist teaser, closing CTA, footer. Grounds alternate by the D1
 * layered-grounds rule; diagonal joins seat on the boundaries (D5).
 *
 * Copy sources, shipped verbatim (spec section 10):
 *   - Hero, process, care, teaser, closing: docs/copy/home-page-copy.md
 *     approved copy, per spec sections 5.1, 5.5, 5.7, 5.8, 5.9.
 *   - Why us (region 4): DIG-994 document `why-us-reframe-copy` slots
 *     A-G, with the integration rulings from the build brief (slot F as
 *     its own panel, slot G as the section CTA, no promise numeral in
 *     this section, R2 kicker).
 *   - Facts row and promise band: DIG-25 document `services` offer facts.
 *
 * SEO: preserved values verbatim (DIG-101). Exactly one H1, rendered
 * once. Motion: CSS-only load choreography (6.1), scroll reveals (6.2),
 * the promise count-up (6.3) and the logo sweep (6.4). Added JS stays
 * under the 2 KB gz budget; zero React islands; zero new dependencies.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import DiagonalJoin from '../components/DiagonalJoin.astro';
import GrainLayer from '../components/GrainLayer.astro';
import FactsRow from '../components/home/FactsRow.astro';
import WhyUs from '../components/home/WhyUs.astro';
import ServiceIndex from '../components/home/ServiceIndex.astro';
import PromiseBand from '../components/home/PromiseBand.astro';
import CareBlock from '../components/home/CareBlock.astro';
import ChecklistTeaser from '../components/home/ChecklistTeaser.astro';
import { withBase } from '../lib/urls';

const steps = [
  {
    lead: 'You send the short form.',
    body: 'We talk about your business, and then you get a clear quote. You decide with the price in front of you.',
  },
  {
    lead: 'We design and build.',
    body: 'Your website takes shape around your customers. You see it and approve it before it goes live.',
  },
  {
    lead: 'We look after it.',
    body: 'After launch, we host it, manage it, and improve it. Every month.',
  },
];
---

<BaseLayout
  title="Digital Marketing Agency South Africa | Digitally Shifted"
  titleSuffix={false}
  description="Digitally Shifted builds, hosts and manages websites for South African businesses. Web design, the Care plan and SEO to bring in leads."
  path="/"
  robots="follow, index, max-snippet:-1, max-video-preview:-1, max-image-preview:large"
  ogImage="/og/home-page-banner.jpg"
  ogImageWidth="1904"
  ogImageHeight="901"
  ogImageAlt="Digitally Shifted digital marketing agency hero banner"
>
  <script is:inline slot="head">
    /* Pre-paint motion flags (DIG-993 spec 6.2/6.4): the reveal system and
       the logo sweep mount only on the home page. */
    document.documentElement.classList.add('js-reveal', 'js-logo-sweep');
  </script>

  <!-- Client motion scripts (DIG-993 spec 6.2/6.3): scroll reveals and the
       promise count-up. Bundled by Astro, deferred, ~1.5 KB gz total. -->
  <script>
    import '../scripts/reveal';
    import '../scripts/count-up';
  </script>

  <!-- Region 2: hero (spec 5.1). Carbon, grid background (D8) + grain
       (D7, server-rendered inline SVG so the band never becomes the LCP
       paint), single-column statement. The H1 is the LCP element and is
       server-rendered; the word choreography is pure CSS (spec 6.1):
       words are fully opaque at first paint and settle into place. -->
  <div class="grain relative overflow-hidden bg-carbon">
    <GrainLayer filterId="ds-grain-hero" />
    <div class="container-ds relative pt-24 pb-16 md:pt-32 md:pb-24 lg:pt-40 lg:pb-32">
      <div class="grid-bg-12" aria-hidden="true"></div>
      <div class="relative z-10 max-w-4xl">
        <p class="shift-enter text-eyebrow uppercase text-text-on-dark-muted">
          Websites, hosting and SEO
        </p>
        <h1 class="mt-6 text-display text-paper md:text-display-xl">
          <span class="split-word" style="--word-i: 0">Digital</span>{' '}
          <span class="split-word" style="--word-i: 1">Marketing</span>{' '}
          <span class="split-word" style="--word-i: 2">Agency</span>{' '}
          <em>
            <span class="split-word" style="--word-i: 3">South</span>{' '}
            <span class="split-word" style="--word-i: 4">Africa</span>
          </em>
        </h1>
        <p
          class="shift-enter mt-6 max-w-xl text-body-lg text-text-on-dark-muted"
          style="--enter-delay: 360ms"
        >
          Digitally Shifted designs, builds, hosts, and manages websites for
          South African businesses, so new customers find you and contact you.
        </p>
        <div class="shift-enter mt-10 flex flex-wrap items-center gap-x-8 gap-y-4" style="--enter-delay: 480ms">
          <a href={withBase('/contact?need=quote')} class="btn btn--primary" data-ds-location="content">
            Get a quote
          </a>
          <a href={withBase('/services')} class="link-dark text-body">See what is included</a>
        </div>
      </div>
    </div>
    <div class="container-ds">
      <DiagonalJoin from="grey-700" tick />
    </div>
  </div>

  <!-- Region 3: facts row (spec 5.2). -->
  <FactsRow />

  <!-- Region 4: why us (spec 5.3; DIG-994 slots A-G). -->
  <WhyUs />

  <!-- Region 5: services index (spec 5.4). -->
  <ServiceIndex />

  <!-- Region 6: process (spec 5.5, restyle in place, #how-we-work kept).
       Mobile steps connect on a 1px grey-300 hairline; numerals are
       informative and reveal with their step. -->
  <section class="bg-grey-100" aria-labelledby="how-we-work">
    <div class="container-ds section">
      <div data-reveal data-reveal-index="0">
        <SectionHeader
          id="how-we-work"
          dark={false}
          eyebrow="Process"
          heading="How we work"
          opener="Three steps take you from your first message to launch day. You always know what happens next."
        />
      </div>
      <ol class="mt-12 grid gap-8 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li
              data-reveal
              data-reveal-index={index + 1}
              class:list={[
                'border-l border-grey-300 pl-6',
                'md:border-l-0 md:pl-0',
              ]}
            >
              <p class="text-display-xl tabular-nums text-text-on-light">{`0${index + 1}`}</p>
              <p class="mt-4 text-h4 text-text-on-light">
                <strong>{step.lead}</strong>
              </p>
              <p class="mt-2 max-w-[42rem] text-body-sm text-text-on-light-muted">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="container-ds">
      <DiagonalJoin from="grey-300" />
    </div>
  </section>

  <!-- Region 7: promise band (spec 5.6). -->
  <PromiseBand />

  <!-- Region 8: care plan (spec 5.7). -->
  <CareBlock />

  <!-- Region 9: checklist teaser (spec 5.8). -->
  <ChecklistTeaser />

  <!-- Region 10: closing CTA (spec 5.9). -->
  <CtaBand
    id="closing-cta"
    textured
    grain
    panelClass="bg-grey-900"
    reveal
    heading={'Ready <em>when you are</em>'}
    line="Tell us what your business needs. We reply with a clear quote, and work starts only when you approve it."
    ctaHref="/contact?need=quote"
    ctaLabel="Get a quote"
    note="We aim to reply within one business day."
  />
</BaseLayout>
