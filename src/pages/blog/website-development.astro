---
/*
 * Blog topic filter: Website Development (DIG-72). Verbatim category
 * text. The topic's post merged into the website development service page.
 *
 * Phase 2 (DIG-1009 spec 5.9): Masked Heading hero, Glare Hover cards,
 * sparse scroll reveals, diagonal join. Copy unchanged.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../lib/urls';
---

<BaseLayout
  title="Website development posts"
  description="Website development advice for planning, building and improving conversion-focused business websites: responsive design, performance and content structure."
  path="/blog/website-development"
>
  <script is:inline slot="head">
    /* Pre-paint motion flag (DIG-1009 spec 5.9): the reveal system mounts
       on this page. */
    document.documentElement.classList.add('js-reveal');
  </script>

  <!-- Scroll reveals (DIG-1009 spec 5.9). -->
  <script>
    import '../../scripts/reveal';
  </script>

  <PageHero
    eyebrow="Blog topic"
    statement="Website Development"
    opener="Explore website development advice for planning, building and improving conversion-focused business websites. Digitally Shifted covers WordPress development, responsive design, website performance, user experience and content structure for South African businesses that need a stronger digital foundation."
    ctaHref="/contact?need=quote"
    masked
    joinFrom="grey-300"
  />

  <section class="bg-paper" aria-labelledby="posts">
    <div class="container-ds section">
      <div data-reveal data-reveal-index="0">
        <SectionHeader id="posts" eyebrow="From the archive" heading='Where the posts <em>live now</em>.' dark={false} />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div data-reveal data-reveal-index="1">
          <Card title="Professional Website Development (August 2024)" dark={false} glare>
            <p>This guide now lives with our website development service, where we keep it current.</p>
            <div slot="action" class="mt-4">
              <a class="link-light text-body" href={withBase('/services/website-development')}>Read it on the service page</a>
            </div>
          </Card>
        </div>
      </div>
      <div class="mt-10">
        <a class="link-light text-body" href={withBase('/blog')}>All blog topics</a>
      </div>
    </div>
  </section>
</BaseLayout>
