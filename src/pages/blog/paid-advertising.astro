---
/*
 * Blog topic filter: Paid Advertising (DIG-72). Verbatim category text.
 * DIG-83: the launch site ships no paid advertising service page; the old
 * post URL 301s to /services/ (DIG-109). The card carries the approved
 * DIG-111 replacement copy and links to the quote enquiry, not to a page.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../lib/urls';
---

<BaseLayout
  title="Paid advertising posts"
  description="Practical insights into Google Ads, Meta campaigns, targeting, budget control and ROI measurement for businesses that want clearer leads and smarter spend."
  path="/blog/paid-advertising"
>
  <PageHero
    eyebrow="Blog topic"
    statement="Paid Advertising"
    opener="Improve paid media performance with practical insights into Google Ads, Meta campaigns, targeting, budget control and ROI measurement. Digitally Shifted shares paid advertising guidance for South African businesses that need clearer leads, smarter spend and campaigns connected to real commercial outcomes."
    ctaHref="/contact?need=quote"
  />

  <section class="bg-paper" aria-labelledby="posts">
    <div class="container-ds section">
      <SectionHeader id="posts" eyebrow="From the archive" heading='Where this topic <em>stands now</em>.' dark={false} />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Card title="Paid advertising" dark={false}>
          <p>Digitally Shifted offers paid advertising as a separate, quoted service. Ask us about a campaign for your business.</p>
          <div slot="action" class="mt-4">
            <a class="link-light text-body" href={withBase('/contact?need=quote')}>Get a quote</a>
          </div>
        </Card>
      </div>
      <div class="mt-10">
        <a class="link-light text-body" href={withBase('/blog')}>All blog topics</a>
      </div>
    </div>
  </section>
</BaseLayout>
