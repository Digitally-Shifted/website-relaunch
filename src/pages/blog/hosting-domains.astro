---
/*
 * Blog topic filter: Hosting & Domains (DIG-72). Verbatim category text.
 * The topic's post merged into the Domains and Hosting service page.
 *
 * Phase 2 (DIG-1009 spec 5.10): Masked Heading hero, Glare Hover cards,
 * sparse scroll reveals, diagonal join. Copy unchanged.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Card from '../../components/Card.astro';
import { withBase } from '../../lib/urls';
---

<BaseLayout
  title="Hosting and domain posts"
  description="Domain and hosting guidance for a stable, secure and fast site: registration, WordPress hosting, website speed, email protection and technical choices."
  path="/blog/hosting-domains"
>
  <script is:inline slot="head">
    /* Pre-paint motion flag (DIG-1009 spec 5.10): the reveal system mounts
       on this page. */
    document.documentElement.classList.add('js-reveal');
  </script>

  <!-- Scroll reveals (DIG-1009 spec 5.10). -->
  <script>
    import '../../scripts/reveal';
  </script>

  <PageHero
    eyebrow="Blog topic"
    statement="Hosting &amp; Domains"
    opener="Find domain and hosting guidance for building a stable, secure and fast online presence. Digitally Shifted helps South African businesses understand domain registration, WordPress hosting, website speed, email protection and the technical hosting choices that support reliable digital growth."
    ctaHref="/contact?need=quote"
    masked
    joinFrom="grey-300"
  />

  <section class="bg-paper" aria-labelledby="posts">
    <div class="container-ds section">
      <div data-reveal data-reveal-index="0">
        <SectionHeader id="posts" eyebrow="From the archive" heading='Where the posts <em>live now</em>.' dark={false} />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div data-reveal data-reveal-index="1">
          <Card title="Expert Domain and Hosting Services (July 2024)" dark={false} glare>
            <p>This guide now lives with our Domains and Hosting service, where we keep it current.</p>
            <div slot="action" class="mt-4">
              <a class="link-light text-body" href={withBase('/services/domains-hosting')}>Read it on the service page</a>
            </div>
          </Card>
        </div>
      </div>
      <div class="mt-10">
        <a class="link-light text-body" href={withBase('/blog')}>All blog topics</a>
      </div>
    </div>
  </section>
</BaseLayout>
