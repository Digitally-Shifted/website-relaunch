---
/*
 * ContentLayout — the standard content page template (DIG-71). One column
 * of prose on a Paper ground at the 60-75 character measure, with a page
 * title block. Used by /privacy today and by future long-form pages
 * (blog posts land through the content migration).
 */
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  path: string;
  eyebrow?: string;
  /** Optional line under the title, for example a date or byline. */
  meta?: string;
  noindex?: boolean;
}

const { title, description, path, eyebrow, meta, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex={noindex} hideMobileBar={true}>
  <div class="bg-paper">
    <div class="container-ds pt-16 pb-24 md:pt-24 md:pb-32">
      <nav aria-label="Breadcrumb" class="text-caption text-slate">
        <a href={withBase('/')} class="link-light">Home</a>
        <span aria-hidden="true"> /</span>
      </nav>
      <header class="mt-6 max-w-2xl">
        {
          eyebrow && <p class="text-eyebrow uppercase text-slate">{eyebrow}</p>
        }
        <h1 class="mt-3 text-h1 text-text-on-light">{title}</h1>
        {meta && <p class="mt-3 text-caption text-slate">{meta}</p>}
      </header>

      <div class="prose-ds mt-12 max-w-[42rem] text-body text-text-on-light">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
