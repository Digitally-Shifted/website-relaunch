{
  "name": "website-relaunch",
  "version": "0.1.0",
  "private": true,
  "description": "Digitally Shifted website relaunch — Astro static site with the DS design tokens v4.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "audit:a11y": "node tools/a11y/bin/scan.mjs",
    "audit:a11y:contrast": "node tools/a11y/bin/token-contrast.mjs",
    "audit:a11y:fixture": "node tools/a11y/bin/verify-fixture.mjs",
    "audit:a11y:keyboard": "node tools/a11y/bin/keyboard-pass.mjs",
    "audit:a11y:checklist": "node tools/a11y/bin/manual-checklist.mjs",
    "test": "node --test test/*.test.mjs",
    "test:analytics": "node analytics/test/run-tests.cjs",
    "test:backend": "node --test form-backend/test/"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "axe-core": "^4.14.0",
    "html-validate": "^11.16.4",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
